        "id": "build",
        "label": "1. Plan and build",
        "focus": [
          "lookahead",
          "execute",
          "diary"
        ],
        "note": "Plan three weeks ahead, build, and record labour, plant, weather and delays every day."
      },
      {
        "id": "inspect",
        "label": "2. Inspect and record",
        "focus": [
          "inspect",
          "ncr",
          "progress"
        ],
        "note": "Nothing is covered up without a signed inspection. Failed work becomes an NCR and is rechecked."
      },
      {
        "id": "change",
        "label": "3. Change control",
        "focus": [
          "instr",
          "notice",
          "price",
          "approve"
        ],
        "note": "Every instruction gets a written notice inside the contract period, then a priced VO."
      },
      {
        "id": "time",
        "label": "4. Delay and billing",
        "focus": [
          "eot",
          "progress",
          "billing"
        ],
        "note": "Delays are noticed on time with diary records. Approved progress and VOs go to monthly billing."
      }
