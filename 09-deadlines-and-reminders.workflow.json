    "views": [
      {
        "id": "capture",
        "label": "1. Every date has an owner",
        "focus": [
          "records",
          "register"
        ],
        "note": "Any record with a date (IPC, bill, bond, VO notice, NCR) enters the register with an owner and a next step."
      },
      {
        "id": "sweep",
        "label": "2. Daily sweep",
        "focus": [
          "register",
          "sweep",
          "notify"
        ],
        "note": "Each day the system flags what is approaching, due, or late, and tells the owner exactly what to do next."
      },
      {
        "id": "act",
        "label": "3. Act and close",
        "focus": [
          "notify",
          "act",
          "done"
        ],
        "note": "The owner does the step and attaches proof. The item closes with a time stamp."
      },
      {
        "id": "escalate",
        "label": "4. Escalate",
        "focus": [
          "escalate",
          "act",
          "digest"
        ],
        "note": "Late for 3 days goes to the PM, then the Director. Monday digest lists open items by owner."
      }
    ],
