    "views": [
      {
        "id": "data",
        "label": "1. Collect the numbers",
        "focus": [
          "commit",
          "actual",
          "earned"
        ],
        "note": "Commitments count when approved. Actuals from GRNs and bills. Value from certified and unbilled work."
      },
      {
        "id": "cvr",
        "label": "2. Cost vs value",
        "focus": [
          "costrep",
          "cvr",
          "eac"
        ],
        "note": "By cost code: budget, committed, actual, forecast. Compare cost to value earned to see real margin."
      },
      {
        "id": "close",
        "label": "3. Close the month",
        "focus": [
          "cvr",
          "close"
        ],
        "note": "Book accruals for received but unbilled goods, and WIP, so the P&L that goes to review is complete."
      },
      {
        "id": "act",
        "label": "4. Review and act",
        "focus": [
          "alert",
          "review",
          "action"
        ],
        "note": "Overruns alert as soon as they are committed. Each review ends with actions, an owner and a date."
      }
    ],
    "viewBox": [
      1030,
      660
    ]
