        "id": "cash",
        "label": "3. Bill and collect",
        "focus": [
          "build",
          "vo",
          "ipc",
          "certify",
          "collect"
        ],
        "note": "Measure monthly, bill the client with variations, chase certification and cash by ageing."
      },
      {
        "id": "close",
        "label": "4. Close out",
        "focus": [
          "closeout",
          "handover",
          "final"
        ],
        "note": "Complete, hand over, settle every final account and release retention and bonds."
