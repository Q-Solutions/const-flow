    "views": [
      {
        "id": "tender",
        "label": "1. Tender and award",
        "focus": [
          "scope",
          "bids",
          "level",
          "award"
        ],
        "note": "Define the package, get quotes from approved subs, level scope gaps, and award within the budget."
      },
      {
        "id": "start",
        "label": "2. Secure and start",
        "focus": [
          "award",
          "bond",
          "advance",
          "works"
        ],
        "note": "No start without bond and insurance on file. Advance is paid only against a guarantee."
      },
      {
        "id": "value",
        "label": "3. Measure and value",
        "focus": [
          "apply",
          "measure",
          "value",
          "variation"
        ],
        "note": "Sub claims monthly. Site verifies quantity and quality. QS values it with approved variations only."
      },
      {
        "id": "pay",
        "label": "4. Certify and pay",
        "focus": [
          "cert",
          "ledger",
          "pay"
        ],
        "note": "Net = work done less retention, advance recovery, backcharges and tax. Pay by the contract due date."
      }
    ]
  },
