        "id": "prepare",
        "label": "1. Prepare the IPC",
        "focus": [
          "cutoff",
          "draft",
          "review"
        ],
        "note": "At cut-off, value work done, approved VOs and materials on site, less retention and advance recovery."
      },
      {
        "id": "certify",
        "label": "2. Get it certified",
        "focus": [
          "review",
          "assess",
          "cert",
          "dispute"
        ],
        "note": "Submit on time. Track the engineer's certification deadline. Query any short-certified item in 7 days."
      },
      {
        "id": "collect",
        "label": "3. Invoice and collect",
        "focus": [
          "cert",
          "invoice",
          "receipt"
        ],
        "note": "Invoice the certified amount the same day. Match every receipt to its invoice and bank line."
      },
      {
        "id": "ageing",
        "label": "4. Ageing and follow-up",
        "focus": [
          "remind",
          "overdue",
          "receipt"
        ],
        "note": "Remind 7 days before due and on due. At 30, 60, 90 days overdue, escalate and apply contract remedies."
      }
    ],
