    "views": [
      {
        "id": "capture",
        "label": "1. Capture every bill",
        "focus": [
          "supp",
          "subc",
          "petty",
          "ledger"
        ],
        "note": "Matched supplier bills, certified sub payments and site expenses land in one ledger with due dates."
      },
      {
        "id": "plan",
        "label": "2. Age and forecast",
        "focus": [
          "ageing",
          "forecast"
        ],
        "note": "Each week, age what is due and overdue, and forecast 13 weeks of cash with expected client receipts."
      },
      {
        "id": "pay",
        "label": "3. Propose, approve, pay",
        "focus": [
          "proposal",
          "approve",
          "pay",
          "recon"
        ],
        "note": "AP proposes by due date and priority. FD approves within cash. Pay, send remittance, reconcile bank."
      },
      {
        "id": "exceptions",
        "label": "Holds and shortfalls",
        "focus": [
          "hold",
          "short"
        ],
        "note": "Bills without proof are held and chased. If cash is short, FD defers, funds, or pushes AR collection."
      }
    ],
    "viewBox": [
      1030,
      660
    ]
